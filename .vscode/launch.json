{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DiskLens: Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-mingw-debug/DiskLens.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "D:/Qt/6.11.1/mingw_64/bin;D:/Qt/Tools/mingw1310_64/bin;${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/Qt/Tools/mingw1310_64/bin/gdb.exe",
      "preLaunchTask": "DiskLens: Build",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
